    <script>
        //  1. Данные пользователя и функции входа/регистрации 
        window.userData = {};

        window.register = function() {
            const firstName = prompt('Введите имя');
            if (firstName === null) return;
            const lastName = prompt('Введите фамилию');
            if (lastName === null) return;
            const email = prompt('Введите почту');
            if (email === null) return;
            window.userData = { firstName, lastName, email };
            console.log('Зарегистрирован:', window.userData);
            alert('Регистрация успешна!');
            if (document.getElementById('profileDialog').open) {
                updateProfileDialog();
            }
        };

        window.login = function() {
            const fullName = prompt('Введите имя и фамилию (через пробел)');
            if (fullName === null) return;
            const email = prompt('Введите почту');
            if (email === null) return;
            const parts = fullName.trim().split(' ');
            const firstName = parts[0] || '';
            const lastName = parts.slice(1).join(' ') || '';
            window.userData = { firstName, lastName, email };
            console.log('Вошёл:', window.userData);
            alert('Вход выполнен!');
            if (document.getElementById('profileDialog').open) {
                updateProfileDialog();
            }
        };

        //  2. Профиль (диалог) 
        window.showProfile = function() {
            const dialog = document.getElementById('profileDialog');
            const content = document.getElementById('profileContent');
            const actionBtn = document.getElementById('profileActionBtn');

            if (window.userData && window.userData.email) {
                const name = (window.userData.firstName || '') + ' ' + (window.userData.lastName || '');
                content.innerHTML = `
                    <p><strong>Имя:</strong> ${name.trim() || 'Не указано'}</p>
                    <p><strong>Почта:</strong> ${window.userData.email}</p>
                `;
                actionBtn.textContent = 'Выйти';
                actionBtn.dataset.action = 'logout';
            } else {
                content.innerHTML = `<p>Вы не авторизованы.</p>`;
                actionBtn.textContent = 'Вход';
                actionBtn.dataset.action = 'login';
            }
            dialog.showModal();
        };

        window.profileAction = function() {
            const action = document.getElementById('profileActionBtn').dataset.action;
            if (action === 'logout') {
                window.userData = {};
                alert('Вы вышли из профиля.');
                document.getElementById('profileDialog').close();
            } else if (action === 'login') {
                document.getElementById('profileDialog').close();
                window.login();
                setTimeout(() => window.showProfile(), 100);
            }
        };

        window.updateProfileDialog = function() {
            if (document.getElementById('profileDialog').open) {
                window.showProfile();
            }
        };

        //  3. Календарь (Vue 3 Composition API) 
        const { createApp, ref, computed } = Vue;

        const calendarApp = createApp({
            setup() {
                const currentMonth = ref(new Date().getMonth());
                const currentYear = ref(new Date().getFullYear());

                const monthName = computed(() => {
                    return new Date(currentYear.value, currentMonth.value)
                        .toLocaleString('ru', { month: 'long' });
                });

                const year = computed(() => currentYear.value);

                const daysInMonth = computed(() => {
                    return new Date(currentYear.value, currentMonth.value + 1, 0).getDate();
                });

                const firstDayIndex = computed(() => {
                    const day = new Date(currentYear.value, currentMonth.value, 1).getDay();
                    return day === 0 ? 6 : day - 1;
                });

                const weeks = computed(() => {
                    const totalDays = daysInMonth.value;
                    const firstDay = firstDayIndex.value;
                    const daysArray = [];
                    for (let i = 0; i < firstDay; i++) {
                        daysArray.push(null);
                    }
                    for (let i = 1; i <= totalDays; i++) {
                        daysArray.push(i);
                    }
                    const weeks = [];
                    for (let i = 0; i < daysArray.length; i += 7) {
                        weeks.push(daysArray.slice(i, i + 7));
                    }
                    return weeks;
                });

                const prevMonth = () => {
                    if (currentMonth.value === 0) {
                        currentMonth.value = 11;
                        currentYear.value--;
                    } else {
                        currentMonth.value--;
                    }
                };

                const nextMonth = () => {
                    if (currentMonth.value === 11) {
                        currentMonth.value = 0;
                        currentYear.value++;
                    } else {
                        currentMonth.value++;
                    }
                };

                return {
                    currentMonth,
                    currentYear,
                    monthName,
                    year,
                    weeks,
                    prevMonth,
                    nextMonth
                };
            }
        });

        calendarApp.mount('#calendar-app');
    </script>
